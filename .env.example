# Where the realtime server lives.
# Local development uses the default and needs nothing here.
# In production set this to your deployed PartyKit host, with no protocol.
VITE_PARTYKIT_HOST=127.0.0.1:1999

# TURN is optional. Set these on the PartyKit server, not here:
#   npx partykit env add TURN_KEY_ID
#   npx partykit env add TURN_KEY_API_TOKEN
