{
  "name": "gathera",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Gathera - a tiny pixel world that happens to contain your office",
  "scripts": {
    "dev": "vite",
    "party": "wrangler dev --port 1999",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "party:deploy": "wrangler deploy",
    "art": "python3 tools/generate_art.py && python3 tools/generate_map.py"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.0.2",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "partykit": "^0.0.111",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.121.0"
  }
}
